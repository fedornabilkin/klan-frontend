# Frontend requires no additional runtime variables.
# Copy this comment to the production environment secret PRODUCTION_ENV.
# Public runtime settings, if added later, must use raw KEY=value lines.
# Never put API, database or Telegram secrets here.
# KLAN_DOMAIN=:80, API_UPSTREAM=api:3001 and FRONTEND_ROOT=/srv are fixed in Compose.
# IMAGE_REF is supplied by the deployment workflow, not by this file.
