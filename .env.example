# Development proxy and local port. VITE_* values are public, never use secrets.
VITE_API_TARGET=http://127.0.0.1:3001
VITE_DEV_PORT=5173

# Docker Compose / Caddy runtime settings. Copy to .env for Compose.
# :80 serves local HTTP; use a real domain and ports 80/443 in production.
KLAN_DOMAIN=:80
API_UPSTREAM=host.docker.internal:3001
FRONTEND_BIND=127.0.0.1
FRONTEND_HTTP_PORT=8080
FRONTEND_HTTPS_PORT=8443
# Optional existing external Docker network (deploy/compose.network.yaml).
KLAN_NETWORK=klan
